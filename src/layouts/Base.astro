---
import '../styles/site.css';
import { SITE, url } from '../config';
// Preloading the fonts means text is drawn once in the right font, instead of swapping later (no layout shift).
import fredoka from '../assets/fonts/fredoka-600.woff2?url';
import andika from '../assets/fonts/andika-400.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path inside the site, for the canonical link. '' for home. */
  path: string;
  image?: string;
  jsonLd?: object[];
  nav?: 'home' | 'math' | 'language' | 'grown-ups' | 'privacy' | 'none';
}
const { title, description, path, image = 'og.png', jsonLd = [], nav = 'none' } = Astro.props;
const canonical = new URL(url(path), Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="preload" href={fredoka} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={andika} as="font" type="font/woff2" crossorigin>
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml">
  <meta name="theme-color" content="#FFF7E8">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  {jsonLd.map(d => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={url()}>
        <img src={url('favicon.svg')} alt="" width="46" height="48">
        <span>{SITE.name}</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href={url('math-games/')} aria-current={nav === 'math' ? 'page' : undefined}>Math games</a>
        <a href={url('language-games/')} aria-current={nav === 'language' ? 'page' : undefined}>Reading games</a>
        <a href={url('grown-ups/')} aria-current={nav === 'grown-ups' ? 'page' : undefined}>Grown-ups</a>
      </nav>
      <div class="tools">
        <button class="iconbtn" data-player-chip type="button" aria-label="Change player" style="visibility:hidden"></button>
        <button class="iconbtn" data-sound-toggle type="button" aria-label="Sound" aria-pressed="true">
          <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z" fill="currentColor"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"/></svg>
          <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z" fill="currentColor"/><path d="M17 9l5 6M22 9l-5 6"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main" class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>{SITE.name}: {SITE.tagline}. Made by <a href={SITE.makerUrl}>{SITE.maker}</a>.</p>
      <nav aria-label="Footer">
        <a href={url('math-games/')}>Math games</a>
        <a href={url('language-games/')}>Reading games</a>
        <a href={url('grown-ups/')}>Grown-ups</a>
        <a href={url('privacy/')}>Privacy</a>
      </nav>
    </div>
  </footer>

  <dialog id="player-picker" aria-labelledby="picker-title">
    <h2 id="picker-title" style="margin-top:0">Who's playing?</h2>
    <div class="picker-grid" data-picker-grid></div>
    <form method="dialog"><button class="btn btn--plain" value="cancel">Close</button></form>
  </dialog>

  <script>
    import { initSite } from '../scripts/site';
    initSite();
  </script>
</body>
</html>
